# Скопируйте этот файл в .env и укажите свои значения
DB_SERVER=localhost
DB_DATABASE=PhotoCenterDB
DB_USER=sa
DB_PASSWORD=YourStrong@Password
DB_PORT=1433
# true, если сервер требует шифрованное соединение (Azure SQL и т.п.)
DB_ENCRYPT=false
# true для локального SQL Server с самоподписанным сертификатом
DB_TRUST_CERT=true

PORT=3000
